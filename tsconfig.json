{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "alwaysStrict": true,
    "esModuleInterop": true,
    "importHelpers": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "paths": {},
    "resolveJsonModule": true,
    "rootDir": ".",
    "types": ["bun"]
  },
  "exclude": ["e2e/fixture/app", "test/fixtures", "e2e/fixture/types"],
  "extends": "@tsconfig/bun/tsconfig.json",
  "include": ["*.config.mts", "*.config.ts", "e2e/**/*", "scripts/**/*", "src/**/*", "test/**/*", "types/**/*"]
}
